<Window x:Class="BuildMonitor.TrayApp.BuildMonitorHealthWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Build Monitor Health"

        Width="980"

        Height="520"

        MinWidth="640"

        MinHeight="300"

        WindowStartupLocation="Manual">

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" MinHeight="80" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0"

                   Text="Build Monitor Health"

                   FontWeight="SemiBold"

                   FontSize="14" />

        <DockPanel Grid.Row="1" Margin="0,8,0,10" LastChildFill="True">

            <Button DockPanel.Dock="Right"

                    Content="Refresh now"

                    Padding="10,4"

                    Margin="12,0,0,0"

                    Click="RefreshNowClicked" />

            <TextBlock x:Name="SummaryText"

                       VerticalAlignment="Center"

                       TextTrimming="CharacterEllipsis"

                       TextWrapping="NoWrap"

                       Opacity="0.85" />

        </DockPanel>



        <DataGrid x:Name="WorkersGrid"

                  Grid.Row="2"

                  AutoGenerateColumns="False"

                  IsReadOnly="True"

                  CanUserAddRows="False"

                  CanUserDeleteRows="False"

                  CanUserResizeRows="False"

                  RowHeight="26"

                  SelectionMode="Single"

                  HeadersVisibility="Column"

                  GridLinesVisibility="Horizontal"

                  ScrollViewer.CanContentScroll="True"

                  ScrollViewer.HorizontalScrollBarVisibility="Auto"

                  ScrollViewer.VerticalScrollBarVisibility="Auto"

                  Margin="0,0,0,10">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="76" />

                <DataGridTextColumn Header="Worker" Binding="{Binding DisplayName}" Width="1.4*" MinWidth="96" />

                <DataGridTextColumn Header="Group" Binding="{Binding Category}" Width="72" />

                <DataGridTextColumn Header="Thread" Binding="{Binding ThreadLabel}" Width="52" />

                <DataGridTextColumn Header="Last heartbeat" Binding="{Binding LastHeartbeatLocal}" Width="112" />

                <DataGridTextColumn Header="Age" Binding="{Binding AgeLabel}" Width="64" />

                <DataGridTextColumn Header="Beats" Binding="{Binding HeartbeatCount}" Width="52" />

                <DataGridTextColumn Header="Last work" Binding="{Binding LastWorkLabel}" Width="68" />

                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" MinWidth="72" />

            </DataGrid.Columns>

        </DataGrid>



        <Border x:Name="CurrentActionsPanel"

                Grid.Row="3"

                Padding="12"

                CornerRadius="6"

                BorderThickness="1"

                Background="{DynamicResource ThemeCardBrush}"

                BorderBrush="{DynamicResource ThemeBorderBrush}">

            <StackPanel>

                <TextBlock Text="Current activity"

                           FontWeight="SemiBold"

                           FontSize="13"

                           Margin="0,0,0,8" />

                <TextBlock x:Name="CurrentActionsIdleText"

                           Text="All workers idle."

                           Opacity="0.65"

                           FontStyle="Italic"

                           Visibility="Collapsed"

                           Margin="0,0,0,4" />

                <ScrollViewer MaxHeight="160"

                              VerticalScrollBarVisibility="Auto"

                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="CurrentActionsList">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="8,5,0,5"

                                        Margin="0,0,0,1"

                                        BorderBrush="{DynamicResource ThemeBorderBrush}"

                                        BorderThickness="0,0,0,1">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="BorderThickness" Value="3,0,0,1" />

                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeMutedBrush}" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Tone}" Value="active">

                                                    <Setter Property="BorderBrush" Value="#FFC107" />

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Tone}" Value="success">

                                                    <Setter Property="BorderBrush" Value="#28A745" />

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Tone}" Value="warning">

                                                    <Setter Property="BorderBrush" Value="#FD7E14" />

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Tone}" Value="error">

                                                    <Setter Property="BorderBrush" Value="#DC3545" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <Grid Margin="4,0,0,0">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="160" />

                                            <ColumnDefinition Width="*" />

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Worker}"

                                                   FontWeight="SemiBold"

                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="1"

                                                   Text="{Binding Action}"

                                                   TextTrimming="CharacterEllipsis"

                                                   Margin="12,0,0,0"

                                                   FontWeight="SemiBold">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeMutedBrush}" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding Tone}" Value="active">

                                                            <Setter Property="Foreground" Value="#FFC107" />

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Tone}" Value="success">

                                                            <Setter Property="Foreground" Value="#28A745" />

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Tone}" Value="warning">

                                                            <Setter Property="Foreground" Value="#FD7E14" />

                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Tone}" Value="error">

                                                            <Setter Property="Foreground" Value="#DC3545" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </StackPanel>

        </Border>



        <TextBlock x:Name="BuildIdentityFooterText"
                   Grid.Row="4"

                   Margin="0,10,0,0"

                   Opacity="0.75"

                   FontSize="11"

                   TextTrimming="CharacterEllipsis"

                   TextWrapping="NoWrap"

                   Text="Dispatcher pings every 250 ms. Tray health UI pass includes icon, status panel, and toasts." />

    </Grid>

</Window>

