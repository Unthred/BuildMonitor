<Window x:Class="BuildMonitor.TrayApp.SettingsWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Local Build Monitor Settings"

        Width="1200"
        Height="800"
        MinWidth="1020"
        MinHeight="700"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Loaded="WindowLoaded">

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <TabControl Grid.Row="0">

            <TabItem Header="Projects">

                <Grid Margin="4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="248" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>



                    <DockPanel Grid.Column="0" Margin="0,0,12,0">

                        <TextBlock DockPanel.Dock="Top" Text="Projects — check to monitor this session" Margin="0,0,0,4" />

                        <TextBlock DockPanel.Dock="Top" Text="Unchecked projects stay in the list but do not build or run until checked."
                                   TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" />

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">

                            <Button Content="Add" Width="60" Click="AddProjectClicked">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add local project" Click="AddLocalProjectClicked" />
                                        <MenuItem Header="Add from Azure DevOps…" Click="AddFromAzureClicked" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button Content="Remove" Width="70" Margin="6,0,0,0" Click="RemoveProjectClicked" />

                        </StackPanel>

                        <ListBox x:Name="ProjectsList"

                                 SelectionChanged="ProjectsListSelectionChanged">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <DockPanel LastChildFill="True" Margin="0,2">

                                        <CheckBox DockPanel.Dock="Left"

                                                  IsChecked="{Binding IsActiveInSession, Mode=TwoWay}"

                                                  VerticalAlignment="Center"

                                                  Margin="0,0,8,0"

                                                  ToolTip="Monitor this project in the current session" />

                                        <TextBlock Text="{Binding ListLabel}"

                                                   VerticalAlignment="Center"

                                                   TextTrimming="CharacterEllipsis" />

                                    </DockPanel>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </DockPanel>



                    <Grid x:Name="EditorPanel" Grid.Column="1" IsEnabled="False">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                        <!-- One outer grid for all peer rows: Left | gutter | Right -->
                        <Grid Grid.IsSharedSizeScope="True">
                        <Grid.Resources>
                            <!-- BasedOn theme styles — keyed styles without BasedOn dropped dark ComboBox chrome (#89 regression). -->
                            <Style x:Key="SettingsFieldTextBox" TargetType="{x:Type TextBox}"
                                   BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="26" />
                                <Setter Property="Margin" Value="0,4,0,10" />
                            </Style>
                            <Style x:Key="SettingsFieldComboBox" TargetType="{x:Type ComboBox}"
                                   BasedOn="{StaticResource {x:Type ComboBox}}">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="26" />
                                <Setter Property="Margin" Value="0,4,0,10" />
                            </Style>
                            <Style x:Key="SettingsSectionHeader" TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                            </Style>
                            <Style x:Key="SettingsSectionHelp" TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Opacity" Value="0.75" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                            <Style x:Key="SettingsContextMetaHeading" TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Opacity" Value="0.72" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                            <Style x:Key="SettingsContextMetaBody" TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Opacity" Value="0.68" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                            </Style>
                            <Style x:Key="SettingsFieldLabel" TargetType="{x:Type TextBlock}"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                <Setter Property="Margin" Value="0,0,0,0" />
                            </Style>
                            <Style x:Key="SettingsSectionCardChrome" TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                            <Style TargetType="Border" x:Key="SettingsSectionCard">
                                <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="4" />
                                <Setter Property="Padding" Value="12" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                            </Style>
                            <!-- Field control margin inside shared peer rows (bottom gap owned by next label row). -->
                            <Style x:Key="SettingsPeerFieldComboBox" TargetType="{x:Type ComboBox}"
                                   BasedOn="{StaticResource SettingsFieldComboBox}">
                                <Setter Property="Margin" Value="0,4,0,0" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                            <Style x:Key="SettingsPeerFieldTextBox" TargetType="{x:Type TextBox}"
                                   BasedOn="{StaticResource SettingsFieldTextBox}">
                                <Setter Property="Margin" Value="0,4,0,0" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Project | Build CLI — one parent Grid owns shared peer-field Y positions -->
                        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.RowSpan="10" Grid.Column="0"
                                    Style="{StaticResource SettingsSectionCardChrome}" />
                            <Border Grid.Row="0" Grid.RowSpan="10" Grid.Column="2"
                                    Style="{StaticResource SettingsSectionCardChrome}" />

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="12,12,12,0"
                                       Text="Project" Style="{StaticResource SettingsSectionHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,12,12,0"
                                       Text="Build CLI" Style="{StaticResource SettingsSectionHeader}" />

                            <!-- Peer 1: Display name ↔ Launch profile -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="12,0,12,0"
                                       Text="Display name" Style="{StaticResource SettingsFieldLabel}" />
                            <TextBlock x:Name="LaunchProfileLabel"
                                       Grid.Row="1" Grid.Column="2" Margin="12,0,12,0"
                                       Text="Launch profile"
                                       Style="{StaticResource SettingsFieldLabel}"
                                       ToolTip="Use https when available — matches dotnet run / Visual Studio." />

                            <TextBox Grid.Row="2" Grid.Column="0" Margin="12,4,12,0"
                                     x:Name="DisplayNameText"
                                     Style="{StaticResource SettingsPeerFieldTextBox}"
                                     TextChanged="DisplayNameTextChanged" />
                            <ComboBox Grid.Row="2" Grid.Column="2" Margin="12,4,12,0"
                                      x:Name="LaunchProfileCombo"
                                      Style="{StaticResource SettingsPeerFieldComboBox}"
                                      IsEditable="True"
                                      SelectionChanged="LaunchProfileComboSelectionChanged" />

                            <!-- Project-only: Azure -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="12,10,12,0">
                                <TextBlock Text="Azure DevOps" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock x:Name="AzureAttachmentSummary"
                                           Text="No Azure association"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button x:Name="AttachAzureButton"
                                            Content="Attach Azure DevOps…"
                                            Padding="8,4"
                                            Click="AttachAzureClicked" />
                                    <Button x:Name="ChangeAzureButton"
                                            Content="Change…"
                                            Margin="6,0,0,0"
                                            Padding="8,4"
                                            Click="ChangeAzureClicked" />
                                    <Button x:Name="DetachAzureButton"
                                            Content="Detach"
                                            Margin="6,0,0,0"
                                            Padding="8,4"
                                            Click="DetachAzureClicked" />
                                    <Button x:Name="AssociateLocalButton"
                                            Content="Associate local…"
                                            Margin="6,0,0,0"
                                            Padding="8,4"
                                            Click="AssociateLocalClicked" />
                                </StackPanel>
                                <TextBlock x:Name="AzureOnlyHint"
                                           Text="Azure-only project: local build/run options are hidden until a local folder is associated. Active Azure projects with selected pipelines are polled continuously."
                                           TextWrapping="Wrap"
                                           Opacity="0.8"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Build CLI context: between Launch profile and Preferred site URL -->
                            <StackPanel x:Name="BuildCliLaunchBehaviourPanel"
                                        Grid.Row="3" Grid.Column="2" Margin="12,10,12,0"
                                        VerticalAlignment="Top">
                                <TextBlock x:Name="BuildCliLaunchBehaviourTitle"
                                           Style="{StaticResource SettingsContextMetaHeading}"
                                           Text="Launch behaviour" />
                                <TextBlock x:Name="BuildCliLaunchBehaviourBody"
                                           Style="{StaticResource SettingsContextMetaBody}"
                                           Text="" />
                            </StackPanel>

                            <!-- Peer 2: Root folder ↔ Preferred site URL -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="12,10,12,0"
                                       Text="Root folder" Style="{StaticResource SettingsFieldLabel}" />
                            <TextBlock x:Name="SiteUrlLabel"
                                       Grid.Row="4" Grid.Column="2" Margin="12,10,12,0"
                                       Text="Preferred site URL"
                                       Style="{StaticResource SettingsFieldLabel}"
                                       ToolTip="When the launch profile lists both HTTP and HTTPS, which URL to show and open." />

                            <DockPanel Grid.Row="5" Grid.Column="0" Margin="12,4,12,0" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Browse" Width="70" Margin="6,0,0,0"
                                        Click="BrowseFolderClicked" />
                                <TextBox x:Name="RootFolderText"
                                         Style="{StaticResource SettingsPeerFieldTextBox}" />
                            </DockPanel>
                            <ComboBox Grid.Row="5" Grid.Column="2" Margin="12,4,12,0"
                                      x:Name="PreferredSiteUrlCombo"
                                      Style="{StaticResource SettingsPeerFieldComboBox}" />

                            <StackPanel Grid.Row="6" Grid.Column="2" Margin="12,10,12,0">
                                <TextBlock Text="Open links with"
                                           Style="{StaticResource SettingsFieldLabel}"
                                           ToolTip="Browser used for Azure links, site URL, and other http(s) navigation from this project's status panel." />
                                <ComboBox x:Name="LinkBrowserCombo"
                                          Margin="0,4,0,0"
                                          Style="{StaticResource SettingsPeerFieldComboBox}"
                                          SelectionChanged="LinkBrowserComboSelectionChanged" />
                            </StackPanel>

                            <!-- Project-only: Cursor agent -->
                            <StackPanel Grid.Row="6" Grid.Column="0" Margin="12,10,12,0">
                                <TextBlock Text="Cursor agent integration" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock x:Name="AgentSkillStatusSummary"
                                           Text="Not checked"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,2"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AgentSkillStatusDetail"
                                           Text="Select a project to see whether the control-plane skill and always-on rule are installed."
                                           Opacity="0.85"
                                           Margin="0,0,0,6"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallAgentSkillButton"
                                            Content="Install / Update"
                                            Padding="10,4"
                                            Click="InstallAgentSkillClicked"
                                            ToolTip="Copies the BuildMonitor skill and an always-on Cursor rule into this project's .cursor folder so agents use busy/idle/ship-check without paste." />
                                    <Button Content="Refresh"
                                            Margin="8,0,0,0"
                                            Padding="10,4"
                                            Click="RefreshAgentSkillStatusClicked"
                                            ToolTip="Re-check whether the installed skill and rule match this BuildMonitor version." />
                                </StackPanel>
                            </StackPanel>

                            <!-- Build CLI context: between Preferred site URL and Extra dotnet args -->
                            <StackPanel x:Name="BuildCliDetectionPanel"
                                        Grid.Row="7" Grid.Column="2" Margin="12,10,12,0"
                                        VerticalAlignment="Top">
                                <TextBlock x:Name="BuildCliDetectionTitle"
                                           Style="{StaticResource SettingsContextMetaHeading}"
                                           Text="Detected application" />
                                <TextBlock x:Name="BuildCliDetectionBody"
                                           Style="{StaticResource SettingsContextMetaBody}"
                                           Text="" />
                            </StackPanel>

                            <!-- Peer 3: Project file ↔ Extra dotnet args -->
                            <TextBlock Grid.Row="8" Grid.Column="0" Margin="12,10,12,0"
                                       Text="Project file (.csproj / .sln)" Style="{StaticResource SettingsFieldLabel}" />
                            <TextBlock Grid.Row="8" Grid.Column="2" Margin="12,10,12,0"
                                       Text="Extra dotnet args"
                                       Style="{StaticResource SettingsFieldLabel}"
                                       ToolTip="Applied to run commands; also inspected for risky base-output paths during builds." />

                            <DockPanel Grid.Row="9" Grid.Column="0" Margin="12,4,12,12" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Browse" Width="70" Margin="6,0,0,0"
                                        Click="BrowseProjectFileClicked" />
                                <TextBox x:Name="ProjectFileText"
                                         Style="{StaticResource SettingsPeerFieldTextBox}"
                                         LostFocus="ProjectFileTextLostFocus" />
                            </DockPanel>
                            <TextBox Grid.Row="9" Grid.Column="2" Margin="12,4,12,12"
                                     x:Name="ExtraArgsText"
                                     Style="{StaticResource SettingsPeerFieldTextBox}" />
                        </Grid>

                        <!-- Run & restart | Tests — one parent Grid owns shared row Y positions -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.RowSpan="8" Grid.Column="0"
                                    Style="{StaticResource SettingsSectionCardChrome}" />
                            <Border Grid.Row="0" Grid.RowSpan="8" Grid.Column="2"
                                    Style="{StaticResource SettingsSectionCardChrome}" />

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="12,12,12,0"
                                       Text="Run &amp; restart" Style="{StaticResource SettingsSectionHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,12,12,0"
                                       Text="Tests" Style="{StaticResource SettingsSectionHeader}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="12,0,12,0"
                                       Text="Watch — debounced rebuilds (default). Run — dotnet run once. None — build only."
                                       Style="{StaticResource SettingsSectionHelp}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,0,12,0"
                                       Text="Leave test target blank to auto-detect a .sln/.slnx or *Tests.csproj."
                                       Style="{StaticResource SettingsSectionHelp}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="12,0,12,0"
                                       Text="Run mode" Style="{StaticResource SettingsFieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,0,12,0"
                                       Text="Test project / solution (optional)" Style="{StaticResource SettingsFieldLabel}" />

                            <ComboBox Grid.Row="3" Grid.Column="0" Margin="12,4,12,0"
                                      x:Name="RunModeCombo"
                                      Style="{StaticResource SettingsPeerFieldComboBox}"
                                      VerticalAlignment="Top"
                                      SelectionChanged="RunModeComboSelectionChanged" />
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="12,4,12,0">
                                <ComboBox x:Name="TestProjectCombo"
                                          Style="{StaticResource SettingsPeerFieldComboBox}"
                                          IsEditable="True"
                                          LostFocus="TestProjectComboLostFocus" />
                                <TextBlock x:Name="TestTargetEffectiveHint"
                                           TextWrapping="Wrap"
                                           Opacity="0.75"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="12,10,12,0"
                                       Text="Build control"
                                       Style="{StaticResource SettingsFieldLabel}"
                                       ToolTip="File Watching — automatic rebuilds on change. AI Controlled — observe only; agent/manual rebuild required." />
                            <TextBlock Grid.Row="4" Grid.Column="2" Margin="12,10,12,0"
                                       Text="Run tests" Style="{StaticResource SettingsFieldLabel}" />

                            <ComboBox Grid.Row="5" Grid.Column="0" Margin="12,4,12,0"
                                      x:Name="BuildControlModeCombo"
                                      Style="{StaticResource SettingsPeerFieldComboBox}" />
                            <ComboBox Grid.Row="5" Grid.Column="2" Margin="12,4,12,0"
                                      x:Name="RunTestsCombo"
                                      Style="{StaticResource SettingsPeerFieldComboBox}" />

                            <StackPanel Grid.Row="6" Grid.Column="0" Margin="12,10,12,12">
                                <CheckBox x:Name="StartOnLaunchCheck"
                                          Content="Start build when app launches"
                                          ToolTip="When checked, this project builds and runs automatically on app startup and after saving settings. Requires Active in session (left list)."
                                          Margin="0,0,0,10" />
                                <StackPanel x:Name="RestartOptionsPanel">
                                    <CheckBox x:Name="RestartOnCrashCheck" Content="Restart on crash" Margin="0,0,0,6" />
                                    <CheckBox x:Name="AutoRestartOnWatchChangesCheck"
                                              Content="Auto-restart on file changes (dotnet watch)"
                                              ToolTip="When enabled, dotnet watch restarts the app automatically. Turn off to restart manually from the tray menu."
                                              Margin="0,0,0,6" />
                                    <CheckBox x:Name="AutoRestartOnHotReloadRequestCheck"
                                              Content="Auto-restart when output requires it"
                                              ToolTip="When build or run output contains hot-reload messages such as 'requires restarting the application', restart or rebuild automatically."
                                              Margin="0,0,0,6" />
                                    <CheckBox x:Name="RestartAppAfterRebuildCheck"
                                              Content="Restart app after rebuild"
                                              ToolTip="When the app was running, start it again after a successful rebuild (manual or file-triggered)."
                                              Margin="0,0,0,8" />
                                    <TextBlock Text="Max restart retries" Style="{StaticResource SettingsFieldLabel}" />
                                    <TextBox x:Name="MaxRetriesText"
                                             Style="{StaticResource SettingsFieldTextBox}"
                                             Width="80"
                                             HorizontalAlignment="Left"
                                             Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- File watching | Excludes — one parent Grid owns shared row Y positions -->
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                                    Style="{StaticResource SettingsSectionCardChrome}" />
                            <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="2"
                                    Style="{StaticResource SettingsSectionCardChrome}" />

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="12,12,12,0"
                                       Text="File watching" Style="{StaticResource SettingsSectionHeader}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,12,12,0"
                                       Text="Excludes &amp; locks" Style="{StaticResource SettingsSectionHeader}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="12,0,12,0"
                                       Text="When Run mode is Watch, prefer Watch only unless using Trigger rebuild mode."
                                       Style="{StaticResource SettingsSectionHelp}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,0,12,0"
                                       Text="Semicolon-separated folder names ignored by the file watcher."
                                       Style="{StaticResource SettingsSectionHelp}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="12,0,12,0"
                                       Text="File changes" Style="{StaticResource SettingsFieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,0,12,0"
                                       Text="Watch exclude segments" Style="{StaticResource SettingsFieldLabel}" />

                            <ComboBox Grid.Row="3" Grid.Column="0" Margin="12,4,12,0"
                                      x:Name="FileChangesCombo"
                                      Style="{StaticResource SettingsPeerFieldComboBox}" />
                            <TextBox Grid.Row="3" Grid.Column="2" Margin="12,4,12,0"
                                     x:Name="WatchExcludeSegmentsText"
                                     Style="{StaticResource SettingsPeerFieldTextBox}"
                                     ToolTip="Semicolon-separated folder names ignored by BuildMonitor file watcher. For dotnet watch, also add Watch Remove entries to your .csproj (see docs/features/health-and-logs.md)." />

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="12,10,12,12">
                                <TextBlock Text="Auto-open log"
                                           Style="{StaticResource SettingsFieldLabel}"
                                           ToolTip="When to open the log viewer automatically after a build or test completes." />
                                <ComboBox x:Name="AutoOpenLogCombo"
                                          Style="{StaticResource SettingsFieldComboBox}" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2" Margin="12,10,12,12">
                                <CheckBox x:Name="ReleaseOutputLocksCheck"
                                          Content="Stop processes locking build output before build and tests"
                                          ToolTip="Attempts a graceful stop of apps running this project outside Build Monitor (e.g. dotnet run in a terminal) before builds. For tests, run/watch usually stays up (--no-build); this setting applies when a full test rebuild is needed or on lock-error retry. Works for processes you own; apps started elsewhere or with higher privileges must be closed manually." />
                                <CheckBox x:Name="ForceCompleteWarningCountsCheck"
                                          Content="Always report full warning counts (--no-incremental)"
                                          Margin="0,8,0,0"
                                          ToolTip="Forces a full compile on every build (including file-change) so MSBuild re-emits the complete warning/error summary. Turn off for faster file-change builds — those may show 0/0 when nothing recompiled. Startup and Rebuild always use a full compile." />
                                <CheckBox x:Name="AutoRepairCorruptedOutputCheck"
                                          Content="Auto-repair corrupted build output (artifacts/bin/obj)"
                                          Margin="0,8,0,0"
                                          ToolTip="When build output indicates a poisoned MSBuild output tree, stop watch/run, delete artifacts/, bin/, and obj/ under the project root, then retry the build." />
                            </StackPanel>
                        </Grid>

                        </Grid>

                        </ScrollViewer>

                    </Grid>

                </Grid>

            </TabItem>



            <TabItem Header="Azure">

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">

                    <Border Background="{DynamicResource ThemeCardBrush}"

                            BorderBrush="{DynamicResource ThemeBorderBrush}"

                            BorderThickness="1"

                            CornerRadius="8"

                            Padding="16"

                            MaxWidth="640"

                            HorizontalAlignment="Left">

                        <StackPanel>

                            <TextBlock Text="Azure DevOps connection"

                                       FontSize="16"

                                       FontWeight="SemiBold"

                                       Margin="0,0,0,8" />

                            <TextBlock TextWrapping="Wrap"

                                       Opacity="0.85"

                                       Margin="0,0,0,16"

                                       Text="Configure an organisation connection and PAT for discovery. Use Projects → Add from Azure / Attach to associate repositories. Active projects with one or more selected pipelines are polled continuously (hover BUILDS and tray health)." />

                            <TextBlock Text="Display name" Margin="0,0,0,4" />

                            <TextBox x:Name="AzureDisplayNameText" Margin="0,0,0,12" />

                            <TextBlock Text="Organisation URL" Margin="0,0,0,4" />

                            <TextBox x:Name="AzureOrganizationUrlText"

                                     Margin="0,0,0,4"

                                     ToolTip="Example: https://dev.azure.com/contoso" />

                            <TextBlock Text="https://dev.azure.com/{organization}"

                                       Opacity="0.7"

                                       FontSize="11"

                                       Margin="0,0,0,12" />

                            <TextBlock x:Name="AzureCredentialStatusText"

                                       Margin="0,0,0,4"

                                       FontWeight="SemiBold" />

                            <TextBlock Text="Personal access token" Margin="0,0,0,4" />

                            <PasswordBox x:Name="AzurePatBox" Margin="0,0,0,4" />

                            <TextBlock TextWrapping="Wrap"

                                       Opacity="0.75"

                                       FontSize="11"

                                       Margin="0,0,0,12"

                                       Text="Leave blank to keep the stored credential. A new value is saved only when you click Save on this window (not on Test)." />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">

                                <Button Width="120"

                                        Margin="0,0,8,0"

                                        Content="Test connection"

                                        Click="AzureTestConnectionClicked" />

                            </StackPanel>

                            <TextBlock x:Name="AzureConnectionResultText"

                                       TextWrapping="Wrap"

                                       MinHeight="40" />

                        </StackPanel>

                    </Border>

                </ScrollViewer>

            </TabItem>



            <TabItem Header="Monitor">

                <Grid Margin="8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>



                    <Border Grid.Column="0"

                            Background="{DynamicResource ThemeCardBrush}"

                            BorderBrush="{DynamicResource ThemeBorderBrush}"

                            BorderThickness="1"

                            CornerRadius="4"

                            Padding="12"

                            Margin="0,0,6,0">

                        <StackPanel>

                            <TextBlock Text="Session" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                            <TextBlock Text="How projects are monitored in this session."

                                       TextWrapping="Wrap"

                                       Opacity="0.85"

                                       Margin="0,0,0,12" />

                            <TextBlock Text="Max concurrent active projects" />

                            <TextBox x:Name="MaxConcurrentText" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Text="Health refresh interval (seconds)" />

                            <TextBox x:Name="HealthRefreshText" Margin="0,4,0,12" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Text="Max log display size (bytes)" />

                            <TextBox x:Name="MaxLogBytesText" Margin="0,4,0,12" Width="160" HorizontalAlignment="Left" />

                            <TextBlock Text="Agent control plane (loopback HTTP)" FontWeight="SemiBold" Margin="0,8,0,6" />

                            <CheckBox x:Name="ControlPlaneEnabledCheck"
                                      Content="Enable localhost control plane"
                                      ToolTip="Bind http://127.0.0.1:{port}/ for Cursor agents (busy/idle + ship-check). Loopback only." />

                            <TextBlock Text="Control plane port" Margin="0,8,0,0"
                                       ToolTip="Port for http://127.0.0.1:{port}/ (1024–65535)." />
                            <TextBox x:Name="ControlPlanePortText" Margin="0,4,0,8" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Text="Busy timeout (seconds)"
                                       ToolTip="If busy and no idle for this long, treat as idle (agent crash)." />
                            <TextBox x:Name="ControlPlaneBusyTimeoutText" Margin="0,4,0,8" Width="120" HorizontalAlignment="Left" />

                            <CheckBox x:Name="SuppressAutoBuildTestsCheck"
                                      Content="Skip tests on auto-build (ship-check / tray Run tests still run)"
                                      ToolTip="When enabled, OnBuildSuccess tests are skipped after file-change builds. Override per project via the control-plane API." />

                            <TextBlock x:Name="ProjectStartBlockedHint"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeAccentBrush}"
                                       Visibility="Collapsed"
                                       Text="Project monitoring is disabled for this app session because BUILDMONITOR_SKIP_PROJECT_START is set in the environment. Remove that variable and restart BuildMonitor to start builds. This is not a saved setting." />

                        </StackPanel>

                    </Border>



                    <StackPanel Grid.Column="1" Margin="6,0,0,0">

                        <Border Background="{DynamicResource ThemeCardBrush}"

                                BorderBrush="{DynamicResource ThemeBorderBrush}"

                                BorderThickness="1"

                                CornerRadius="4"

                                Padding="12"

                                Margin="0,0,0,10">

                            <StackPanel>

                                <TextBlock Text="File change batching" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                                <TextBlock Text="File change debounce (ms)"

                                           ToolTip="Quiet period after the last save before a coalesced rebuild starts. Increase (e.g. 5000) when an AI agent edits many files in a row." />

                                <TextBox x:Name="DebounceMsText" Margin="0,4,0,6" Width="120" HorizontalAlignment="Left" />

                                <TextBlock Text="Debounce mode"
                                           ToolTip="Manual uses the ms value above. Auto learns per project from save burst length." />

                                <ComboBox x:Name="DebounceModeCombo" Margin="0,4,0,6" Width="180" HorizontalAlignment="Left"
                                          SelectionChanged="DebounceModeComboSelectionChanged" />

                                <TextBlock x:Name="LearnedDebounceHintText" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,10" />

                                <CheckBox x:Name="CoalesceWatchRebuildsCheck"

                                          Content="Batch watch-mode rebuilds (wait for edits to settle)"

                                          ToolTip="When enabled, watch mode uses a debounced file watcher and rebuilds once after edits stop instead of dotnet watch rebuilding on every save. Turn off for dotnet watch hot reload." />

                                <CheckBox x:Name="DeferStartupBuildUntilQuietCheck"
                                          Content="Defer startup build until edits settle"
                                          Margin="0,8,0,0"
                                          ToolTip="When starting Build Monitor while Cursor or an agent is still saving files, wait for a quiet period before the first build." />

                                <CheckBox x:Name="CancelSupersededBuildsCheck"
                                          Content="Cancel superseded startup/file-change builds"
                                          Margin="0,4,0,0"
                                          ToolTip="When new saves arrive during a startup or file-change build, cancel the in-flight compile and rebuild once edits settle. Manual tray rebuilds are never cancelled." />

                                <CheckBox x:Name="UseAgentTranscriptActivityCheck"
                                          Content="Treat agent-transcript activity as editing"
                                          Margin="0,4,0,0"
                                          ToolTip="Watch agent-transcripts and .cursor folders for activity signals (does not trigger rebuilds by itself)." />

                                <CheckBox x:Name="LearnFromDiagnosticsVerdictsCheck"
                                          Content="Learn from Unexpected build diagnostics verdicts"
                                          Margin="0,4,0,0"
                                          ToolTip="When you mark a rebuild Unexpected, suggest folders to ignore and increase debounce learning for file-change triggers." />

                            </StackPanel>

                        </Border>



                        <Border Background="{DynamicResource ThemeCardBrush}"

                                BorderBrush="{DynamicResource ThemeBorderBrush}"

                                BorderThickness="1"

                                CornerRadius="4"

                                Padding="12">

                            <StackPanel>

                                <TextBlock Text="Feedback" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                                <CheckBox x:Name="AutoOpenBuildMonitorHealthCheck"

                                          Content="Auto-open Build Monitor Health on startup"

                                          Margin="0,0,0,6" />

                                <CheckBox x:Name="PlaySoundOnErrorCheck"

                                          Content="Play sound when a build fails"

                                          Margin="0,0,0,6" />

                                <CheckBox x:Name="PlaySoundOnSuccessCheck"

                                          Content="Play sound when a build succeeds" />

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Grid>

            </TabItem>



            <TabItem Header="App">

                <Grid Margin="8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>



                    <StackPanel Grid.Column="0" Margin="0,0,6,0">

                        <Border Background="{DynamicResource ThemeCardBrush}"

                                BorderBrush="{DynamicResource ThemeBorderBrush}"

                                BorderThickness="1"

                                CornerRadius="4"

                                Padding="12"

                                Margin="0,0,0,10">

                            <StackPanel>

                                <TextBlock Text="Appearance &amp; startup" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                                <TextBlock Text="Application appearance and startup."

                                           TextWrapping="Wrap"

                                           Opacity="0.85"

                                           Margin="0,0,0,12" />

                                <TextBlock Text="Theme" />

                                <ComboBox x:Name="ThemeCombo" Margin="0,4,0,12" SelectionChanged="ThemeComboSelectionChanged" />

                                <CheckBox x:Name="RunOnLogonCheck" Content="Run when Windows starts" Margin="0,0,0,6" />

                                <CheckBox x:Name="StartMinimizedCheck" Content="Start minimized to tray" />

                                <TextBlock Text="Tray menu layout" Margin="0,12,0,0" />

                                <ComboBox x:Name="TrayMenuLayoutCombo" Margin="0,4,0,0" />

                                <TextBlock Text="Virtual desktops" Margin="0,12,0,4" FontWeight="SemiBold" />

                                <CheckBox x:Name="FollowStatusPanelDesktopCheck"
                                          Content="Status panel follows current desktop"
                                          Margin="0,0,0,4"
                                          ToolTip="When the hover status panel opens, move it onto the Windows virtual desktop you are viewing." />

                                <CheckBox x:Name="FollowBuildLogDesktopCheck"
                                          Content="Build log follows current desktop"
                                          ToolTip="When the build log opens or is brought to the front, move it onto the Windows virtual desktop you are viewing." />

                                <TextBlock Text="Status panel visibility" Margin="0,12,0,4" FontWeight="SemiBold" />

                                <CheckBox x:Name="KeepStatusVisibleDuringLocalBuildCheck"
                                          Content="Keep status visible while Local build is active"
                                          Margin="0,0,0,4"
                                          ToolTip="Shows the hover status panel while any monitored project is building or testing locally, even when the pointer leaves the tray icon." />

                                <CheckBox x:Name="KeepStatusVisibleDuringAzureBuildCheck"
                                          Content="Keep status visible while Azure build is active"
                                          ToolTip="Shows the hover status panel while any monitored project has active Azure CI activity (queued, in progress, or canceling)." />

                            </StackPanel>

                        </Border>



                        <Border Background="{DynamicResource ThemeCardBrush}"

                                BorderBrush="{DynamicResource ThemeBorderBrush}"

                                BorderThickness="1"

                                CornerRadius="4"

                                Padding="12">

                            <StackPanel>

                                <TextBlock Text="Toast display" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="12" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Position" />

                                        <ComboBox x:Name="ToastPositionCombo" Margin="0,4,0,0" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="Duration (seconds, 2–120)" />

                                        <TextBox x:Name="ToastDurationText" Margin="0,4,0,0" Width="80" HorizontalAlignment="Left" />

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Border>

                    </StackPanel>



                    <Border Grid.Column="1"

                            Background="{DynamicResource ThemeCardBrush}"

                            BorderBrush="{DynamicResource ThemeBorderBrush}"

                            BorderThickness="1"

                            CornerRadius="4"

                            Padding="12"

                            Margin="6,0,0,0">

                        <StackPanel>

                            <TextBlock Text="Show toasts for" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">

                                    <CheckBox x:Name="ToastOnBuildStartCheck" Content="Build start (manual / initial)" Margin="0,0,0,6" />

                                    <CheckBox x:Name="ToastOnFileChangeCheck" Content="File change detected" Margin="0,0,0,6" />

                                    <CheckBox x:Name="ToastOnBuildSuccessCheck" Content="Build success" Margin="0,0,0,6" />

                                    <CheckBox x:Name="ToastOnBuildFailureCheck" Content="Build failure" />

                                </StackPanel>

                                <StackPanel Grid.Column="1">

                                    <CheckBox x:Name="ToastOnWarningsCheck" Content="Warnings" Margin="0,0,0,6" />

                                    <CheckBox x:Name="ToastOnErrorsCheck" Content="Errors" Margin="0,0,0,6" />

                                    <CheckBox x:Name="ToastOnInfoCheck" Content="Info" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>

            </TabItem>

        </TabControl>



        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">

            <Button Width="90" Margin="0,0,8,0" IsDefault="True" Click="SaveClicked">Save</Button>

            <Button Width="90" IsCancel="True">Cancel</Button>

        </StackPanel>

    </Grid>

</Window>


