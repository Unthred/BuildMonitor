<Window x:Class="BuildMonitor.TrayApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Build Monitor Settings"
        Width="760"
        Height="720"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Projects">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock DockPanel.Dock="Top" Text="Projects (check to monitor)" Margin="0,0,0,6" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add" Width="60" Click="AddProjectClicked" />
                            <Button Content="Remove" Width="70" Margin="6,0,0,0" Click="RemoveProjectClicked" />
                        </StackPanel>
                        <ListBox x:Name="ProjectsList"
                                 SelectionChanged="ProjectsListSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="0,2">
                                        <CheckBox DockPanel.Dock="Left"
                                                  IsChecked="{Binding IsActiveInSession, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  ToolTip="Monitor this project in the current session" />
                                        <TextBlock Text="{Binding ListLabel}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EditorPanel" IsEnabled="False">
                            <TextBlock Text="Display name" />
                            <TextBox x:Name="DisplayNameText"
                                     Margin="0,4,0,8"
                                     TextChanged="DisplayNameTextChanged" />

                            <TextBlock Text="Root folder" />
                            <DockPanel Margin="0,4,0,8">
                                <Button DockPanel.Dock="Right" Content="Browse" Width="70" Margin="6,0,0,0" Click="BrowseFolderClicked" />
                                <TextBox x:Name="RootFolderText" />
                            </DockPanel>

                            <TextBlock Text="Project file (.csproj / .sln)" />
                            <DockPanel Margin="0,4,0,8">
                                <Button DockPanel.Dock="Right" Content="Browse" Width="70" Margin="6,0,0,0" Click="BrowseProjectFileClicked" />
                                <TextBox x:Name="ProjectFileText"
                                         LostFocus="ProjectFileTextLostFocus" />
                            </DockPanel>

                            <TextBlock Text="Launch profile" />
                            <TextBlock Text="Use https when available — it matches dotnet run / Visual Studio and controls the URL in the status panel."
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="LaunchProfileCombo"
                                      IsEditable="True"
                                      Margin="0,4,0,8"
                                      SelectionChanged="LaunchProfileComboSelectionChanged" />

                            <TextBlock Text="Extra dotnet args" />
                            <TextBox x:Name="ExtraArgsText" Margin="0,4,0,8" />

                            <TextBlock Text="Run mode" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <TextBlock Text="Watch — build then dotnet watch (hot reload). Run — build then dotnet run once. None — build only. Open the URL shown in the status panel (launch profile controls the port)."
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="RunModeCombo" Margin="0,0,0,8" />

                            <CheckBox x:Name="RestartOnCrashCheck" Content="Restart on crash" Margin="0,0,0,8" />
                            <TextBlock Text="Max restart retries" />
                            <TextBox x:Name="MaxRetriesText" Margin="0,4,0,8" />
                            <CheckBox x:Name="AutoRestartOnWatchChangesCheck"
                                      Content="Auto-restart on file changes (watch mode)"
                                      ToolTip="When enabled, dotnet watch restarts the app automatically. Turn off to restart manually from the tray menu."
                                      Margin="0,0,0,8" />
                            <CheckBox x:Name="RestartAppAfterRebuildCheck"
                                      Content="Restart app after rebuild"
                                      ToolTip="When the app was running, start it again after a successful rebuild (manual or file-triggered)."
                                      Margin="0,0,0,8" />

                            <TextBlock Text="Test project / solution (optional)" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <TextBlock Text="Leave blank to auto-detect a .sln/.slnx or *Tests.csproj. The main Project file is used for build/run; tests need a solution or test project."
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="TestProjectCombo"
                                      IsEditable="True"
                                      Margin="0,4,0,8"
                                      LostFocus="TestProjectComboLostFocus" />

                            <TextBlock Text="Run tests" />
                            <ComboBox x:Name="RunTestsCombo" Margin="0,4,0,8" />

                    <TextBlock Text="File changes (when Run Mode is Watch, use Watch only — dotnet watch already rebuilds)"
                               TextWrapping="Wrap"
                               Opacity="0.75"
                               Margin="0,0,0,4" />
                    <ComboBox x:Name="FileChangesCombo" Margin="0,4,0,8" />

                            <CheckBox x:Name="ReleaseOutputLocksCheck"
                                      Content="Stop processes locking build output before build and tests"
                                      ToolTip="Attempts a graceful stop of apps running this project outside Build Monitor (e.g. dotnet run in a terminal) before builds. For tests, run/watch usually stays up (--no-build); this setting applies when a full test rebuild is needed or on lock-error retry. Works for processes you own; apps started elsewhere or with higher privileges must be closed manually."
                                      Margin="0,0,0,8" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Monitor">
                <StackPanel Margin="8" MaxWidth="480">
                    <TextBlock Text="How projects are monitored in this session."
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Opacity="0.85" />
                    <TextBlock Text="Max concurrent active projects" />
                    <TextBox x:Name="MaxConcurrentText" Margin="0,4,0,12" />
                    <TextBlock Text="File change debounce (ms)" />
                    <TextBox x:Name="DebounceMsText" Margin="0,4,0,12" />
                    <TextBlock Text="Health refresh interval (seconds)" />
                    <TextBox x:Name="HealthRefreshText" Margin="0,4,0,12" />
                    <CheckBox x:Name="AutoOpenLogCheck"
                              Content="Auto-open build log when a project fails"
                              Margin="0,0,0,8" />
                    <CheckBox x:Name="PlaySoundOnErrorCheck"
                              Content="Play sound when a build fails"
                              Margin="0,0,0,8" />
                    <CheckBox x:Name="PlaySoundOnSuccessCheck"
                              Content="Play sound when a build succeeds"
                              Margin="0,0,0,12" />
                    <TextBlock Text="Max log display size (bytes)" />
                    <TextBox x:Name="MaxLogBytesText" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <TabItem Header="App">
                <StackPanel Margin="8" MaxWidth="480">
                    <TextBlock Text="Application appearance and startup."
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Opacity="0.85" />
                    <TextBlock Text="Theme" />
                    <ComboBox x:Name="ThemeCombo" Margin="0,4,0,12" SelectionChanged="ThemeComboSelectionChanged" />
                    <CheckBox x:Name="RunOnLogonCheck" Content="Run when Windows starts" Margin="0,0,0,8" />
                    <CheckBox x:Name="StartMinimizedCheck" Content="Start minimized to tray" Margin="0,0,0,12" />

                    <TextBlock Text="Toast notifications" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <TextBlock Text="Position" />
                    <ComboBox x:Name="ToastPositionCombo" Margin="0,4,0,8" />
                    <TextBlock Text="Duration (seconds, 2–120)" />
                    <TextBox x:Name="ToastDurationText" Margin="0,4,0,12" />

                    <TextBlock Text="Show toasts for" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <CheckBox x:Name="ToastOnBuildStartCheck" Content="Build start (manual / initial)" Margin="0,0,0,4" />
                    <CheckBox x:Name="ToastOnFileChangeCheck" Content="File change detected (rebuild triggered)" Margin="0,0,0,4" />
                    <CheckBox x:Name="ToastOnBuildSuccessCheck" Content="Build success" Margin="0,0,0,4" />
                    <CheckBox x:Name="ToastOnBuildFailureCheck" Content="Build failure" Margin="0,0,0,4" />
                    <CheckBox x:Name="ToastOnWarningsCheck" Content="Warnings (lock release, file watcher, etc.)" Margin="0,0,0,4" />
                    <CheckBox x:Name="ToastOnErrorsCheck" Content="Errors (failed to start, save errors, etc.)" Margin="0,0,0,4" />
                    <CheckBox x:Name="ToastOnInfoCheck" Content="Info (locks released, settings saved, etc.)" Margin="0,0,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" Margin="0,0,8,0" IsDefault="True" Click="SaveClicked">Save</Button>
            <Button Width="90" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
