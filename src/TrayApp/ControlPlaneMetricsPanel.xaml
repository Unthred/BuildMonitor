<UserControl x:Class="BuildMonitor.TrayApp.ControlPlaneMetricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False"
             MinHeight="100">
    <UserControl.Resources>
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricHelpStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MetricTileStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="10,8"
            CornerRadius="6"
            BorderThickness="1"
            Background="{DynamicResource ThemeCardBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Snapshot}">
            <TextBlock Text="Agent control plane"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBlock Text="{Binding SummaryLine}"
                       FontSize="11"
                       Opacity="0.8"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Session" />
                        <TextBlock Style="{StaticResource MetricHelpStyle}" Text="Current busy/idle" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding SessionStateText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Busy / idle calls" />
                        <TextBlock Style="{StaticResource MetricHelpStyle}" Text="This process" />
                        <TextBlock Style="{StaticResource MetricValueStyle}">
                            <Run Text="{Binding BusyCalls, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding IdleCalls, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Time busy" />
                        <TextBlock Style="{StaticResource MetricHelpStyle}" Text="Sum of busy intervals" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding TotalBusyTimeText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricTileStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Builds blocked" />
                        <TextBlock Style="{StaticResource MetricHelpStyle}" Text="File-change while busy" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding AutoBuildsBlocked}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricTileStyle}" Margin="0,8,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Ship-check" />
                        <TextBlock Style="{StaticResource MetricHelpStyle}" Text="Pass rate · avg duration" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding ShipCheckSuccessRateText}" />
                        <TextBlock FontSize="10" Opacity="0.75" Margin="0,3,0,0">
                            <Run Text="{Binding ShipCheckPassed, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{Binding ShipCheckTotal, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding AvgShipCheckDurationText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricTileStyle}" Margin="0,8,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Last ship-check" />
                        <TextBlock Style="{StaticResource MetricHelpStyle}" Text="Local time · result" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding LastShipCheckLocal}" />
                        <TextBlock FontSize="10" Opacity="0.75" Margin="0,3,0,0"
                                   Text="{Binding LastShipCheckResultText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricTileStyle}" Margin="0,8,6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Call rate" />
                        <TextBlock Style="{StaticResource MetricHelpStyle}" Text="HTTP calls last hour" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding CallRateText}" />
                        <TextBlock FontSize="10" Opacity="0.75" Margin="0,3,0,0">
                            <Run Text="pause " />
                            <Run Text="{Binding WatchPauseCalls, Mode=OneWay}" />
                            <Run Text=" · resume " />
                            <Run Text="{Binding WatchResumeCalls, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricTileStyle}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="HTTP" />
                        <TextBlock Style="{StaticResource MetricHelpStyle}" Text="Requests · 4xx · 5xx" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding HttpRequests}" />
                        <TextBlock FontSize="10" Opacity="0.75" Margin="0,3,0,0">
                            <Run Text="{Binding HttpClientErrors, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding HttpServerErrors, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
