<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Core\BuildMonitor.Core.csproj" />
    <ProjectReference Include="..\Infrastructure\BuildMonitor.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <GitCommitShort Condition="'$(GitCommitShort)' == ''">unknown</GitCommitShort>
    <GitBranch Condition="'$(GitBranch)' == ''">unknown</GitBranch>
    <BuiltUtc Condition="'$(BuiltUtc)' == ''">unknown</BuiltUtc>
    <GitDirty Condition="'$(GitDirty)' == ''">false</GitDirty>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildMonitor.Version" Value="$(Version)" />
    <AssemblyMetadata Include="BuildMonitor.GitCommit" Value="$(GitCommitShort)" />
    <AssemblyMetadata Include="BuildMonitor.GitBranch" Value="$(GitBranch)" />
    <AssemblyMetadata Include="BuildMonitor.BuiltUtc" Value="$(BuiltUtc)" />
    <AssemblyMetadata Include="BuildMonitor.IsGitDirty" Value="$(GitDirty)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\ops\agent-skills\buildmonitor-control-plane\SKILL.md"
             Link="AgentSkills\buildmonitor-control-plane\SKILL.md"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\ops\agent-skills\buildmonitor-control-plane\RULE.mdc"
             Link="AgentSkills\buildmonitor-control-plane\RULE.mdc"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
