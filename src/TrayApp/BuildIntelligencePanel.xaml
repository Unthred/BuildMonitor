<UserControl x:Class="BuildMonitor.TrayApp.BuildIntelligencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:diag="clr-namespace:BuildMonitor.Infrastructure.Diagnostics;assembly=BuildMonitor.Infrastructure"
             Focusable="False"
             IsTabStop="False"
             KeyboardNavigation.TabNavigation="None"
             MinHeight="140">
    <UserControl.Resources>
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="MetricTileStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Padding="10,8"
            CornerRadius="6"
            BorderThickness="1"
            Focusable="False"
            Background="{DynamicResource ThemeCardBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Snapshot}">
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <Border DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        CornerRadius="10"
                        Focusable="False"
                        Background="{DynamicResource LogIssueWarningBrush}"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowStatusChip}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusChipText}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Focusable="False"
                               Foreground="White" />
                </Border>
                <TextBlock Text="{Binding StatusHeadline}"
                           FontSize="11"
                           FontStyle="Italic"
                           Focusable="False"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricTileStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Quiet wait" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding QuietPeriodText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricTileStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Rebuilds (90 s)" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding RecentFileChangeBuildsIn90s}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricTileStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Triggers today" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding TodayTriggerCount}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricTileStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Typical build" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding RecentBuildDurationLabel}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,6,0">
                    <TextBlock Style="{StaticResource MetricTitleStyle}"
                               Text="Save burst length"
                               ToolTip="Each bar is how long a multi-file save burst lasted." />
                    <Grid Height="56" Margin="0,0,0,4">
                        <ItemsControl ItemsSource="{Binding BurstBars}" Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBurstChartData}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type diag:BurstBarVisual}">
                                    <Border Width="22"
                                            Height="{Binding BarHeight, Mode=OneWay}"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="2"
                                            Background="{DynamicResource ThemeAccentBrush}"
                                            ToolTip="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="—" FontSize="10" Opacity="0.45" VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBurstChartData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource MetricDetailStyle}" Text="{Binding BurstChartCaption}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,6,0">
                    <TextBlock Style="{StaticResource MetricTitleStyle}"
                               Text="Build duration"
                               ToolTip="Recent file-triggered build times." />
                    <Grid Height="56" Margin="0,0,0,4">
                        <ItemsControl ItemsSource="{Binding BuildDurationBars}" Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBuildDurationChartData}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type diag:BurstBarVisual}">
                                    <Border Width="22"
                                            Height="{Binding BarHeight, Mode=OneWay}"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="2"
                                            Background="{DynamicResource LogIssueWarningBrush}"
                                            Opacity="0.85"
                                            ToolTip="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="—" FontSize="10" Opacity="0.45" VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBuildDurationChartData}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource MetricDetailStyle}" Text="{Binding BuildDurationChartCaption}" />
                </StackPanel>

                <Border Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,10,0,0"
                        Style="{StaticResource MetricTileStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MetricTitleStyle}" Text="Next rebuild" />
                        <TextBlock Margin="0,0,0,4"
                                   Text="{Binding NextRebuildReasonText}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MetricDetailStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NextRebuildReasonText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CountdownRemainingText}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRebuildCountdown}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding NextRebuildText}"
                                   TextAlignment="Center" />
                        <ProgressBar Height="10"
                                     Margin="0,8,0,0"
                                     Maximum="100"
                                     Value="{Binding RebuildCountdownPercent, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRebuildCountdown}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Style="{StaticResource MetricDetailStyle}"
                                   Margin="0,6,0,0"
                                   Text="{Binding StrategyText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Margin="0,8,0,0"
                       FontSize="10"
                       Opacity="0.7"
                       Focusable="False"
                       Text="{Binding ActivityText}" />
        </StackPanel>
    </Border>
</UserControl>
