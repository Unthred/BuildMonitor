<Window x:Class="BuildMonitor.TrayApp.BuildDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BuildMonitor.TrayApp"
        Title="Build diagnostics"
        Width="1100"
        Height="720"
        MinWidth="800"
        MinHeight="480"
        WindowStartupLocation="Manual">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <TextBlock x:Name="IntelligenceUpdatedText"
                       DockPanel.Dock="Right"
                       Opacity="0.65"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Text="Updated —" />
            <StackPanel>
                <TextBlock Text="Build diagnostics"
                           FontWeight="SemiBold"
                           FontSize="14" />
                <TextBlock Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Opacity="0.8"
                           FontSize="11"
                           Text="One tab per active project — rebuild timing at the top, today's triggers below. Mark unexpected triggers to train ignore rules and debounce learning." />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="ProjectTabs"
                    Grid.Row="1"
                    Margin="0,0,0,8">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding TabTitle}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <local:BuildIntelligencePanel Snapshot="{Binding Intelligence}" Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Triggers}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Loaded="TriggersGridLoaded"
                                  LayoutUpdated="TriggersGridLayoutUpdated">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When" Binding="{Binding WhenLocal}" Width="120" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding KindLabel}" Width="130" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="150" />
                                <DataGridTextColumn Header="Files" Binding="{Binding ChangedPathsText}" Width="180" />
                                <DataGridTextColumn Header="Likely cause" Binding="{Binding InferredCause}" Width="200" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="140" />
                                <DataGridTextColumn Header="Verdict" Binding="{Binding VerdictLabel}" Width="72" />
                                <DataGridTemplateColumn Header="Your note" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UserNote, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="2"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Tag="{Binding}"
                                                     GotFocus="UserNoteGotFocus"
                                                     LostFocus="UserNoteLostFocus" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Mark" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Expected"
                                                        Padding="6,2"
                                                        Margin="0,0,4,0"
                                                        Tag="{Binding}"
                                                        Click="ExpectedClicked" />
                                                <Button Content="Unexpected"
                                                        Padding="6,2"
                                                        Margin="0,0,4,0"
                                                        Tag="{Binding}"
                                                        Click="UnexpectedClicked" />
                                                <Button Content="Clear"
                                                        Padding="6,2"
                                                        Tag="{Binding}"
                                                        Click="ClearVerdictClicked" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <TextBlock x:Name="EmptyProjectsText"
                   Grid.Row="1"
                   Text="No active projects — enable a project in Settings."
                   Opacity="0.65"
                   FontStyle="Italic"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed" />

        <DockPanel Grid.Row="2" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Refresh" Padding="10,4" Margin="0,0,8,0" Click="RefreshClicked" />
                <Button Content="Close" Padding="10,4" Click="CloseClicked" />
            </StackPanel>
            <CheckBox x:Name="UnexpectedOnlyCheck"
                      Content="Show unexpected only"
                      VerticalAlignment="Center"
                      Checked="FilterChanged"
                      Unchecked="FilterChanged" />
        </DockPanel>
    </Grid>
</Window>
