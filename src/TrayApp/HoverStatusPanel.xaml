<Window x:Class="BuildMonitor.TrayApp.HoverStatusPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Status"
        MinWidth="376"
        Width="376"
        WindowStyle="None"
        SizeToContent="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="PanelBorder" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="6" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="24" />
                <RowDefinition x:Name="BodyRow" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="AccentColumn" Width="68" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderText"
                           Grid.Column="0"
                           FontWeight="Bold"
                           FontSize="12"
                           Text="Build status"
                           VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="PanelHeaderCountdown"
                           Visibility="Collapsed"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#FFC107"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Auto-close or rebuild countdown" />
                <Button x:Name="HeaderStillEditingButton"
                        Visibility="Collapsed"
                        Content="AI working?"
                        Padding="6,1"
                        FontSize="10"
                        VerticalAlignment="Center"
                        ToolTip="AI agent still working — extend the rebuild wait"
                        Cursor="Hand" />
            </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="×"
                        Width="22"
                        Height="22"
                        Padding="0"
                        Margin="4,0,0,0"
                        ToolTip="Close"
                        Click="CloseButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right" />
            </Grid>

            <ItemsControl x:Name="ProjectCards"
                          Grid.Row="1"
                          Grid.Column="0"
                          VerticalAlignment="Top" />

            <Border x:Name="SideRail"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="60"
                    Margin="6,0,0,0"
                    CornerRadius="5"
                    BorderThickness="1"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid x:Name="ActiveAccentContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="AccentGlow"
                                   Grid.RowSpan="2"
                                   RadiusX="5"
                                   RadiusY="5"
                                   Opacity="0.35"
                                   IsHitTestVisible="False" />
                        <Viewbox Grid.Row="0"
                                 Stretch="Uniform"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Margin="4,6,4,2">
                            <Canvas Width="68" Height="68">
                                <Ellipse x:Name="AccentRingOuter"
                                         Width="64"
                                         Height="64"
                                         Canvas.Left="2"
                                         Canvas.Top="2"
                                         StrokeThickness="2.5"
                                         Fill="Transparent"
                                         StrokeDashArray="5 4"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="OuterRingRotate" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="AccentRingInner"
                                         Width="42"
                                         Height="42"
                                         Canvas.Left="13"
                                         Canvas.Top="13"
                                         StrokeThickness="2"
                                         Fill="Transparent"
                                         StrokeDashArray="3 5"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="InnerRingRotate" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="AccentCore"
                                         Width="14"
                                         Height="14"
                                         Canvas.Left="27"
                                         Canvas.Top="27" />
                                <Rectangle x:Name="AccentSparkA"
                                           Width="4"
                                           Height="4"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Canvas.Left="32"
                                           Canvas.Top="4"
                                           Opacity="0.85" />
                                <Rectangle x:Name="AccentSparkB"
                                           Width="3"
                                           Height="3"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Canvas.Left="58"
                                           Canvas.Top="30"
                                           Opacity="0.7" />
                                <Rectangle x:Name="AccentSparkC"
                                           Width="3"
                                           Height="3"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Canvas.Left="8"
                                           Canvas.Top="44"
                                           Opacity="0.6" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="AccentLabel"
                                   Grid.Row="1"
                                   Text="Building"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="56"
                                   Margin="2,0,2,5"
                                   FontSize="9"
                                   FontWeight="Bold" />
                    </Grid>

                    <Grid x:Name="IdleStatusContent" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="IdleRailGlow"
                                   Grid.RowSpan="2"
                                   RadiusX="5"
                                   RadiusY="5"
                                   Opacity="0.28"
                                   IsHitTestVisible="False" />
                        <Viewbox Grid.Row="0"
                                 Stretch="Uniform"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Margin="4,6,4,2">
                            <Canvas Width="44" Height="72">
                                <Rectangle x:Name="IdleHousing"
                                           Width="36"
                                           Height="62"
                                           Canvas.Left="4"
                                           Canvas.Top="5"
                                           RadiusX="8"
                                           RadiusY="8"
                                           StrokeThickness="1.5" />
                                <Ellipse x:Name="IdleLampRed"
                                         Width="14"
                                         Height="14"
                                         Canvas.Left="15"
                                         Canvas.Top="12" />
                                <Ellipse x:Name="IdleLampAmber"
                                         Width="14"
                                         Height="14"
                                         Canvas.Left="15"
                                         Canvas.Top="29" />
                                <Ellipse x:Name="IdleLampGreen"
                                         Width="14"
                                         Height="14"
                                         Canvas.Left="15"
                                         Canvas.Top="46" />
                                <Ellipse x:Name="IdleWebReadyBadge"
                                         Width="8"
                                         Height="8"
                                         Canvas.Left="28"
                                         Canvas.Top="48"
                                         Visibility="Collapsed" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="IdleStatusLabel"
                                   Grid.Row="1"
                                   Text="Healthy"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="56"
                                   Margin="2,0,2,5"
                                   FontSize="9"
                                   FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
