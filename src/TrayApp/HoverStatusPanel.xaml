<Window x:Class="BuildMonitor.TrayApp.HoverStatusPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build Status"
        Width="400"
        MinHeight="96"
        MaxHeight="460"
        WindowStyle="None"
        SizeToContent="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border x:Name="PanelBorder" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="8">
        <DockPanel>
            <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="Bold" FontSize="12" Text="Build status" Margin="0,0,0,4" />
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProjectCards" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
